<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Fix EOL & Warnings -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1202;XA0105</NoWarn>

    <!-- App Info -->
    <ApplicationId>com.queendom.godot</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationTitle>Queendom Godot Silk Editor</ApplicationTitle>

    <!-- APK Packaging Flags -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnablePreloadAssemblies>true</AndroidEnablePreloadAssemblies>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    
    <!-- Auto-sign gamit ang default debug/CI keystore para di mag-error -->
    <AndroidKeyStore>false</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Core" Version="2.22.0" />
  </ItemGroup>

  <!-- Ligtas na pag-include ng .so libraries kahit wala pa o meron nang laman ang libs folder -->
  <ItemGroup Condition="Exists('libs')">
    <AndroidNativeLibrary Include="libs\**\*.so" />
  </ItemGroup>

  <ItemGroup>
    <AndroidManifest Include="AndroidManifest.xml" />
  </ItemGroup>
</Project>
